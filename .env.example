# Copy to .env.local (never commit it). Without it the site runs in local mode.
# Neon: Dashboard → Connect → enable Connection pooling, copy the string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── VPS with docker compose (docker-compose.yml reads this file as .env) ──
# Use long random letters/digits only (e.g. `openssl rand -hex 24`) so they need no URL escaping.
POSTGRES_PASSWORD=change-me-owner-password
ORI_API_PASSWORD=change-me-api-password
# The app connects as the least-privilege API role:
#   DATABASE_URL=postgresql://ori_api:<ORI_API_PASSWORD>@127.0.0.1:5432/ori
# db:setup / db:demo need the owner instead:
#   DATABASE_URL=postgresql://ori:<POSTGRES_PASSWORD>@127.0.0.1:5432/ori npm run db:demo
